JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

CORS_ORIGINS=https://app.yourdomain.com,http://localhost:3000,http://127.0.0.1:3000
PUBLIC_SHARE_BASE=https://app.yourdomain.com

DATABASE_URL=sqlite:////ABSOLUTE/PATH/TO/codex/backend/data/app.db
UPLOAD_DIR=/ABSOLUTE/PATH/TO/codex/backend/data/uploads
EXPORT_DIR=/ABSOLUTE/PATH/TO/codex/backend/data/exports

AMAP_WEB_KEY=
MAP_DEFAULT_CITY=重庆市
INTEL_DEFAULT_CITY=重庆市

BIDMONITOR_BASE_URL=http://127.0.0.1:8080
BIDMONITOR_API_TOKEN=replace-with-bidmonitor-user:replace-with-bidmonitor-password
BIDMONITOR_PULL_PATH=/api/results
BIDMONITOR_USERNAME=replace-with-bidmonitor-user
BIDMONITOR_PASSWORD=replace-with-bidmonitor-password

FOLO_BASE_URL=http://127.0.0.1:9090
FOLO_API_TOKEN=replace-with-a-private-token
FOLO_PULL_PATH=/api/intel/items
FOLO_SYNC_ENABLED=true

# Used by ops/home-hosted/scripts/run_cloudflared.sh on the spare Mac.
CLOUDFLARED_TUNNEL_TOKEN=replace-with-cloudflare-named-tunnel-token

# Used by ops/home-hosted/scripts/backup_runtime_data.sh on the spare Mac.
BACKUP_DIR=/ABSOLUTE/PATH/TO/codex/backups/runtime
BACKUP_RETENTION_DAYS=14
BACKUP_INCLUDE_BRIDGE_DB=true
BACKUP_INCLUDE_BRIDGE_SUBSCRIPTIONS=true
BACKUP_INCLUDE_BIDMONITOR_DB=true
BACKUP_INCLUDE_BIDMONITOR_CONFIG=true
