<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codex.folo-bridge</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__REPO_DIR__/ops/home-hosted/scripts/run_folo_bridge.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>__REPO_DIR__/folo-bridge</string>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/codex-home-hosted/folo-bridge.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/codex-home-hosted/folo-bridge.err.log</string>
</dict>
</plist>
